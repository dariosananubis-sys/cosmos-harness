#!/bin/zsh
set -euo pipefail

service="open-interpreter-openrouter"
venv="$HOME/.local/share/open-interpreter"
launcher="$HOME/.local/bin/oi-deepseek"
model="${OI_MODEL:-openrouter/openrouter/free}"

if [[ "${0:t}" == "oi-deepseek" ]]; then
  api_key="$(security find-generic-password -a "$USER" -s "$service" -w 2>/dev/null)" ||
    { print -u2 "Falta la API key en el Llavero. Ejecuta otra vez el instalador."; exit 1; }
  export OPENROUTER_API_KEY="$api_key"
  unset api_key
  exec "$venv/bin/interpreter" --model "$model" "$@"
fi

command -v brew >/dev/null || {
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
}
brew list python@3.11 >/dev/null 2>&1 || brew install python@3.11
/opt/homebrew/bin/python3.11 -m venv "$venv"
"$venv/bin/python" -m pip install --upgrade pip "setuptools<81" open-interpreter
mkdir -p "$HOME/.local/bin"
cp "$0" "$launcher"
chmod 700 "$launcher"
read -r -s "api_key?Nueva API key de OpenRouter: "
print
[[ "$api_key" == sk-or-v1-* ]] || { print -u2 "Formato de clave no válido."; exit 1; }
security add-generic-password -U -a "$USER" -s "$service" -w "$api_key" >/dev/null
unset api_key
print "Listo. Abre una terminal nueva y ejecuta: oi-deepseek"
